Cell[CellGroupData[{

Cell["Source code", "Section",ExpressionUUID->"d7fc9b4c-924e-445b-8538-aebcffdbf017"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"rules", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\"\<C\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<D\>\"", "->", "1"}], ",", 
          RowBox[{"\"\<L\>\"", "->", "2"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", "payoffBimatrix", ",", " ", 
       RowBox[{"(*", " ", "payoffs", " ", "*)"}], "\[IndentingNewLine]", 
       "As1", ",", "As2", ",", "Bs1", ",", "Bs2", ",", " ", "strategies", ",", 
       RowBox[{"(*", " ", "strategies", " ", "*)"}], "\[IndentingNewLine]", 
       "LMatrix", ",", "FBimatrix", ",", "background", ",", 
       "\[IndentingNewLine]", "Ax", ",", "Bx", ",", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Ax", " ", "is", " ", "the", " ", "fraction", " ", "of", " ", "As1", 
          " ", "in", " ", "subpopulation", " ", "A"}], ",", " ", 
         RowBox[{
         "Bx", " ", "is", " ", "the", " ", "fraction", " ", "of", " ", "Bs1", 
          " ", "in", " ", "subpopulation", " ", "B"}]}], " ", "*)"}], 
       "\[IndentingNewLine]", "\[Delta]r", ",", "mr", ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"closureRule", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Less", "->", "LessEqual"}], ",", 
          RowBox[{"Greater", "->", "GreaterEqual"}]}], "}"}]}], ",", 
       RowBox[{"newRest", "=", "False"}], ",", "\[IndentingNewLine]", 
       "points", ",", "someStrategiesEqual", ",", "\[IndentingNewLine]", 
       "Ap1", ",", "Bp1", ",", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Distributions", " ", "in", " ", "the", " ", "two", " ", "pools", " ",
          "of", " ", 
         RowBox[{"singles", ".", " ", "Used"}], " ", "just", " ", "as", " ", 
         "symbols"}], " ", "*)"}], "\[IndentingNewLine]", "A\[CapitalPi]1", ",",
        "A\[CapitalPi]2", ",", "B\[CapitalPi]1", ",", "B\[CapitalPi]2", ",", 
       RowBox[{"(*", " ", 
        RowBox[{"Payoffs", " ", "for", " ", "each", " ", 
         RowBox[{"strategy", ".", " ", "Used"}], " ", "just", " ", "as", " ", 
         "symbols"}], " ", "*)"}], "\[IndentingNewLine]", "Ax2", ",", "Bx2", ",",
        "Ap2", ",", "Bp2", ",", "restTypes", ",", "restOrder", ",", 
       "commonOptions"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Delta]r", "=", 
       RowBox[{"Rationalize", "[", 
        RowBox[{"\[Delta]", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"mr", "=", 
       RowBox[{"Rationalize", "[", 
        RowBox[{"m", ",", "0"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", "update", ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "This", " ", "is", " ", "a", " ", "trick", " ", "to", " ", "make", " ",
         "the", " ", "\"\<update\>\"", " ", "button", " ", "work"}], " ", 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Subpopulations", " ", "are", " ", "named", " ", "A", " ", "and", " ", 
        "B"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"payoffBimatrix", "=", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a11", ",", "a12", ",", "a21", ",", "a22"}], "}"}], ",", 
           "0"}], "]"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{"{", 
           RowBox[{"R1", ",", "S1", ",", "T1", ",", "P1"}], "}"}], " ", 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Rationalize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b11", ",", "b12", ",", "b21", ",", "b22"}], "}"}], ",", 
           "0"}], "]"}]}], "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"{", 
          RowBox[{"R2", ",", "S2", ",", "T2", ",", "P2"}], "}"}], " ", "*)"}],
         "\[IndentingNewLine]", "}"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"As1", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"As11", ",", "As12", ",", "As13", ",", "As14", ",", "As15"}],
          "}"}], "/.", "rules"}]}], ";", 
      RowBox[{"As1Name", "=", 
       RowBox[{"StrategyName", "[", "As1", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"As2", "=", 
